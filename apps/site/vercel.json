{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ],
  "redirects": [
    {
      "source": "/install.sh",
      "destination": "https://raw.githubusercontent.com/glamboyosa/katalepsis/main/install.sh",
      "permanent": false
    }
  ]
}
